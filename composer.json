{
    "name": "resetnak/makeview",
    "description": "A single-file-ish PHP dashboard for your local projects.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Makeview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Makeview\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}